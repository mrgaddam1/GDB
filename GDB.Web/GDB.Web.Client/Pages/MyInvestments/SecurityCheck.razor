@page "/my-investments/securityCheck"  
@rendermode @(new InteractiveServerRenderMode(prerender:false))


<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    Security Check
                </div>
                <div class="card-body">
                    <div class="col-lg-12">
                        <EditForm Model="@securityCheckViewModel" OnValidSubmit="HandleValidSubmit" >
                            <DataAnnotationsValidator />
                             <ValidationSummary />

                            <div class="row rowMargin">
                                <div class="col-sm-3">
                                    Full Name
                                </div>
                                <div class="col-sm-6">
                                    <InputText type="password" 
                                        @bind-Value="securityCheckViewModel.FullName" 
                                        maxLength="50" 
                                        class="form-control" />
                                    <ValidationMessage For="@(() => securityCheckViewModel.FullName)" />
                                </div>
                            </div>
                             <div class="row rowMargin">
                                <div class="col-sm-3">
                                    Mobile Number
                                </div>
                                <div class="col-sm-6">
                                    <InputText type="password"
                                               @bind-Value="securityCheckViewModel.MobileNumber" 
                                                maxLength="12" 
                                                class="form-control" />
                                    <ValidationMessage For="@(() => securityCheckViewModel.MobileNumber)" />
                                </div>
                            </div>
                            <div class="row rowMargin">
                                <div class="col-sm-3">
                                    Security 12 Digits Password
                                </div>
                                <div class="col-sm-6">
                                    <InputText type="password"
                                               @bind-Value="securityCheckViewModel.Security12DigitsPasscode"
                                               maxLength="12"
                                               class="form-control" />
                                    <ValidationMessage For="@(() => securityCheckViewModel.Security12DigitsPasscode)" />
                                </div>
                            </div>
                            <div class="row rowMargin">
                                <div class="col-sm-3">
                                    Security 6 Digits Pincode
                                </div>
                                <div class="col-sm-6">
                                    <InputText type="password"
                                               @bind-Value="securityCheckViewModel.Security6DigitsPincode"
                                               maxLength="6"
                                               class="form-control" />
                                    <ValidationMessage For="@(() => securityCheckViewModel.Security6DigitsPincode)" />
                                </div>
                            </div>
                            <div class="text-center">
                                <button type="submit" class="btn btn-primary  fw-bold">
                                    <i class="fas fa-plus" aria-hidden="true"></i>
                                    &nbsp;&nbsp; Verify Authentication
                                </button>
                                <button type="button" class="btn btn-warning fw-bold">
                                    <i class="fas fa-times"></i>&nbsp;&nbsp;Cancel
                                </button>
                            </div>
                        </EditForm>

                        @if (submitMessage != null)
                        {
                            <div class="mt-3 alert @(isSuccess ? "alert-success" : "alert-danger")">@submitMessage</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>